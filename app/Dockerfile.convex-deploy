# One-shot job: push convex/ functions to the self-hosted backend.
# Skips cleanly when no admin key is configured yet (first boot).
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY convex ./convex
CMD ["sh", "-c", "if [ -z \"$CONVEX_SELF_HOSTED_ADMIN_KEY\" ]; then echo 'CONVEX_SELF_HOSTED_ADMIN_KEY not set — skipping function deploy (expected on first boot)'; exit 0; fi; npx convex deploy -y --typecheck disable"]
