# ── Gym Tracker production env ──────────────────────────────────────────────
# Copy to .env and fill in. Values shown for a deployment at example.com with
# Dokploy terminating HTTPS and routing domains to the published ports below.

# Public URLs the browser uses to reach the Convex backend (baked into the app
# at build time). Must be HTTPS in production; VITE_CONVEX_URL must equal
# CONVEX_CLOUD_ORIGIN and VITE_CONVEX_SITE_URL must equal CONVEX_SITE_ORIGIN
# (it serves the /api/auth/* login endpoints).
VITE_CONVEX_URL=https://convex.example.com
VITE_CONVEX_SITE_URL=https://convex-site.example.com

# How barcode lookups identify this deployment to Open Food Facts (optional,
# default gym-zero). Courtesy identifier only — OFF rate limits are per IP,
# so sharing a name with other installs costs nothing.
VITE_OFF_APP_NAME=

# Auth lives inside the Convex deployment; its secrets are function env vars,
# set once with the CLI after the admin key exists (see DEPLOY.md):
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL https://gym.example.com
#   npx convex env set INVITE_CODE <code you text the family>

# Convex backend identity. INSTANCE_SECRET: long random hex, e.g. `openssl rand -hex 32`.
# Changing either after first boot invalidates the admin key.
INSTANCE_NAME=gym-tracker
INSTANCE_SECRET=

# Public origins of the Convex backend (API and HTTP-actions side).
CONVEX_CLOUD_ORIGIN=https://convex.example.com
CONVEX_SITE_ORIGIN=https://convex-site.example.com

# Admin key for deploying functions. Empty on first boot; then run
#   docker compose exec backend ./generate_admin_key.sh
# paste the result here and redeploy.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Dashboard: URL it should talk to (public backend URL), and its port.
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex.example.com
DASHBOARD_PORT=6791

# dashboard.example.com ->  → :${DASHBOARD_PORT}

# Published ports (attach your domains to these in Dokploy):
#   app     → https://gym.example.com          → :${APP_PORT}
#   backend → https://convex.example.com       → :${CONVEX_PORT}
#   backend → https://convex-site.example.com  → :${CONVEX_SITE_PROXY_PORT}
APP_PORT=8080
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
